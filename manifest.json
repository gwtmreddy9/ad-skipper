{
  "manifest_version": 3,
  "name": "Ad Skipper",
  "version": "2.1.0",
  "description": "Removes ads from a streaming site's player before playback, including pause ads and the ad markers on the progress bar.",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.hbomax.com/*",
    "*://*.max.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ad_domains",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.hbomax.com/*",
        "*://*.max.com/*"
      ],
      "js": [
        "main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.hbomax.com/*",
        "*://*.max.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ad Skipper",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
